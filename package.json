{
  "name": "svg-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Lab1 Phase 1 SVG command-line editor",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "cli": "tsx src/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "tsc",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "saxes": "6.0.0"
  }
}
