@startuml
title SVG CLI - Architecture and stage D status
top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #526579
skinparam component {
  BackgroundColor #F0F6FC
  BorderColor #526579
  FontColor #17324D
}

component "main.ts\nComposition root" as Main #E9F4EA
component "cli/\nREPL, parser, dispatcher" as Cli
component "commands/\nConcrete command objects" as Commands
component "application/\nSession, history, presenter, ports" as Application
component "model/\nShape tree, rules, factory" as Model #FFF4DF
component "svg/\nXML codec and document gateway\nsaxes 6.0.0" as Svg
component "infrastructure/\nAtomic local text file adapter" as Infrastructure

Main --> Cli
Main --> Application
Main --> Svg
Main --> Infrastructure
Cli --> Commands
Cli --> Application
Commands --> Application
Commands --> Model
Application --> Model
Svg --> Model
Svg --> Application : contracts only
Infrastructure --> Application : contracts only

legend bottom
  Solid arrows = implemented source dependencies.
  XML parsing stays in svg; local file access stays in infrastructure.
  Only CommandDispatcher and ShapeFactory dispatch by name.
endlegend
@enduml
